    { "id": "6", "name": "Debug Step", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [800, 0], "disabled": true, "parameters": {} }
  ],
  "connections": {
    "Every Morning": { "main": [[{ "node": "Get Pending Rows", "type": "main", "index": 0 }]] },
    "Get Pending Rows": { "main": [[{ "node": "Only Ready", "type": "main", "index": 0 }]] },
    "Only Ready": { "main": [[{ "node": "Create Lead", "type": "main", "index": 0 }]] },
    "Create Lead": { "main": [[{ "node": "Write Back", "type": "main", "index": 0 }]] }
  },
