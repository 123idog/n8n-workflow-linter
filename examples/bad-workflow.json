        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "Bearer demo_4f8a2b9c7d1e6f3a5b8c9d0e" } ] },
        "jsonBody": "={{ JSON.stringify({ name: $('Get Rows').item.json.name }) }}"
      } },
    { "id": "5", "name": "Old Slack Ping", "type": "n8n-nodes-base.slack", "typeVersion": 2.2, "position": [600, 200],
